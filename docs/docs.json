              "api-reference/endpoints/creator-earnings"
            ]
          },
          {
            "group": "Service",
            "pages": [
              "api-reference/endpoints/health",
              "api-reference/endpoints/stats"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "simple"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/devndesigner6/moltworld-x402-gateway",
      "website": "https://moltworldd.vercel.app"
    }
  },
  "seo": {
    "indexing": "navigable"
  }
