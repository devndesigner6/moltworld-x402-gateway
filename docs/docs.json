{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Moltworld",
  "description": "Per-call AI chat payments in WIF on Robinhood Chain, with x402 quotes, wallet-authorized settlement, and signed receipts.",
  "colors": {
    "primary": "#0E9F66",
    "light": "#3DDC97",
    "dark": "#0E9F66"
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png",
    "href": "https://moltworldd.vercel.app"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      {
        "href": "https://moltworldd.vercel.app",
        "label": "Website"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/devndesigner6/moltworld-x402-gateway"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Playground",
      "href": "https://moltworldd.vercel.app/playground"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/how-payment-works",
              "concepts/pricing",
              "concepts/receipts",
              "concepts/models",
              "concepts/refunds-and-rebates"
            ]
          },
          {
            "group": "Legacy and beta",
            "pages": [
              "products/mandates",
              "products/marketplace",
              "guides/video-jobs"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/verify-receipts",
              "guides/handle-errors"
            ]
          }
        ]
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "Agent integrations",
            "pages": [
              "agents/mcp",
              "agents/openclaw",
              "agents/hermes",
              "agents/claude-code",
              "agents/a2a"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "Client libraries",
            "pages": [
              "sdks/typescript",
              "sdks/python",
              "sdks/http"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/errors"
            ]
          },
          {
            "group": "Chat",
            "pages": [
              "api-reference/endpoints/chat"
            ]
          },
          {
            "group": "Pricing and catalog",
            "pages": [
              "api-reference/endpoints/quote",
              "api-reference/endpoints/list-models"
            ]
          },
          {
            "group": "Receipts",
            "pages": [
              "api-reference/endpoints/get-receipt",
              "api-reference/endpoints/receipt-keys"
            ]
          },
          {
            "group": "Unavailable on WIF",
            "pages": [
              "api-reference/endpoints/images",
              "api-reference/endpoints/speech",
              "api-reference/endpoints/get-job",
              "api-reference/endpoints/draft-mandate",
              "api-reference/endpoints/register-mandate",
              "api-reference/endpoints/get-mandate",
              "api-reference/endpoints/list-mandates",
              "api-reference/endpoints/revoke-mandate",
